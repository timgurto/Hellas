<root>
	<!-- Named colours -->
	<colour name="highlight"  hex="FFFFB2" />
	<colour name="lightRed"   hex="BA6C62" />
	<colour name="lightGreen" hex="62BA6C" />
	<colour name="green"      hex="357F51" />
	<colour name="darkGreen"  hex="154434" />
	<colour name="yellow"     hex="E8CE94" />
	<colour name="darkYellow" hex="CE9B79" />
	<colour name="darkRed"    hex="A34C5C" />
	<colour name="lightBlue"  hex="3478D8" />
	<colour name="blue"       hex="394FB2" />
	<colour name="darkBlue"   hex="3C388C" />
	<colour name="purple"     hex="772C67" />
	<colour name="lightTeal"  hex="2C6777" />
	<colour name="teal"       hex="1F3C60" />
	<colour name="darkTeal"   hex="161B4C" />
	<colour name="outline"    hex="170A33" />
	<colour name="white"      hex="E5E5E5" />
	<colour name="lightGrey"  hex="C4AAC0" />
	<colour name="grey"       hex="8778A5" />
	<colour name="darkGrey"   hex="413168" />
	<colour name="black"      hex="000000" />

	<!-- 6-variant ground template -->
	<terrainTemplate name="grassy" numVariants="6" colours="darkGrey,white,lightGrey,grey" />

	<terrain name="normal"         template="grassy" colours="yellow,lightGreen,green,lightRed" />
	<terrain name="plains"         template="grassy" colours="green,yellow,lightGreen,darkGreen" />
	<terrain name="rich"           template="grassy" colours="lightGreen,highlight,yellow,green" />
	<terrain name="fertile"        template="grassy" colours="lightGreen,yellow,darkYellow,green" />
	<terrain name="swamp"          template="grassy" colours="lightTeal,lightGreen,grey,green" />
	<terrain name="nile"           template="grassy" colours="highlight,yellow,lightGreen,green" />
	<terrain name="volcanoFertile" template="grassy" colours="darkGrey,lightTeal,green,darkTeal" />
	<terrain name="plainsFertile"  template="grassy" colours="darkGreen,lightGreen,green,darkTeal" />
	<terrain name="richFertile"    template="grassy" colours="green,yellow,darkYellow,darkGreen" />
	<terrain name="swampFertile"   template="grassy" colours="blue,lightGreen,green,teal" />

	<!-- Mountain template (1 variant) -->
	<terrainTemplate name="mountain" numVariants="1" colours="grey,darkYellow,yellow,darkGrey" />

	<terrain name="plainsMountain"  template="mountain" colours="green,grey,lightGrey,darkGrey" />
	<terrain name="desertMountain"  template="mountain" colours="grey,yellow,highlight,darkGrey" />
	<terrain name="snowMountain"    template="mountain" colours="darkGrey,lightGrey,white,outline" />
	<terrain name="beachMountain"   template="mountain" colours="darkGrey,grey,lightGrey,yellow" />
	<terrain name="richMountain"    template="mountain" colours="darkGrey,grey,lightGrey,darkGreen" />
	<terrain name="caveMountain"    template="mountain" colours="darkTeal,darkGrey,grey,outline" />
	<terrain name="volcanoMountain" template="mountain" colours="outline,purple,lightRed,darkRed" />

	<!-- Rocky template (1 variant) -->
	<terrainTemplate name="rocky" numVariants="1" colours="lightGrey,grey,yellow,darkYellow" />

	<terrain name="plainsRocky"  template="rocky" colours="lightGrey,green,grey,darkGreen" />
	<terrain name="desertRocky"  template="rocky" colours="highlight,lightGrey,yellow,grey" />
	<terrain name="snowRocky"    template="rocky" colours="white,lightGrey,grey,purple" />
	<terrain name="richRocky"    template="rocky" colours="lightGrey,green,darkYellow,darkGreen" />
	<terrain name="caveRocky"    template="rocky" colours="grey,darkGrey,darkTeal,outline" />
	<terrain name="beachRocky"   template="rocky" colours="yellow,grey,darkBlue,darkBlue" />
	<terrain name="volcanoRocky" template="rocky" colours="darkGrey,outline,purple,darkRed" />

	<!-- Solid template (1 variant) -->
	<terrainTemplate name="solid" numVariants="1" colours="darkGrey" />

	<terrain name="null" template="solid" colours="black" />
	<terrain name="sky"  template="solid" colours="lightBlue" />
</root>
